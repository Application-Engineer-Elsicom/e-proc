generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENGINEER
  WPO
  PROJECT_MANAGER
  PROCUREMENT
  FINANCE
  WAREHOUSE
}

enum Status {
  WAITING_WPO
  WAITING_PM
  APPROVED
  PROCUREMENT_PROCESS
  FINANCE_PAID
  AVAILABLE_IN_WAREHOUSE
  SHIPPED
  REJECTED
}

enum FaultStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(ENGINEER)
  position  String?
  createdAt DateTime @default(now())

  // Relations
  materialRequests MaterialRequest[] @relation("RequestedBy")
  pmApprovals      MaterialRequest[] @relation("PMApprovedBy")
  wpoApprovals     MaterialRequest[] @relation("WPOApprovedBy")
  faultReports     FaultReport[]
  warehouseReleases WarehouseRelease[]
}

model MaterialRequest {
  id              String   @id @default(cuid()) 
  docControlNo    String   @unique // Format: MR-2026-XXXX
  projectId       String
  projectName     String
  assignSys       String?  // Assign Sys
  assignPM        String?  // Assign PM
  workPackage     String?
  wpo             String?
  keterangan      String?
  status          Status   @default(WAITING_WPO)
  fileUrl         String?  // Lampiran file
  dateReleased    DateTime? // Date Released
  
  items           MaterialRequestItem[]
  suratJalan      SuratJalan[]
  warehouseReleases WarehouseRelease[] // New relation

  requestedBy     String   
  requester       User     @relation("RequestedBy", fields: [requestedBy], references: [id])
  
  wpoApprovedBy   String?  
  wpoApprover     User?    @relation("WPOApprovedBy", fields: [wpoApprovedBy], references: [id])
  
  pmApprovedBy    String?  
  pmApprover      User?    @relation("PMApprovedBy", fields: [pmApprovedBy], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaterialRequestItem {
  id                    Int      @id @default(autoincrement())
  materialRequestId     String
  request               MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  
  description           String
  elsicomPartNum        String?
  manufacturePartNum    String?
  type                  String?  // Type
  manufacturer          String?  // Manufacturer
  qty                   Int
  unit                  String
  targetDate            DateTime?
  remarks               String?
}

model FaultReport {
  id            String      @id @default(cuid())
  docNo         String      @unique // FR-2026-XXXX
  projectId     String?     // Project ID
  projectName   String
  itemName      String?     // Item Name
  manufacturer  String?     // Manufacturer
  targetRepair  DateTime?   // Target Repair
  faultIssue    String?     // Fault Issue
  priority      Priority    @default(MEDIUM)
  status        FaultStatus @default(OPEN)
  description   String?     @db.Text
  
  reportedBy    String
  reporter      User        @relation(fields: [reportedBy], references: [id])
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model WarehouseRelease {
  id                String   @id @default(cuid())
  docNo             String   @unique // WR-2026-XXXX
  
  materialRequestId String?  // Optional: Link to MR
  materialRequest   MaterialRequest? @relation(fields: [materialRequestId], references: [id])

  projectId         String?
  projectName       String?  // Project Name
  deliveryTarget    String?  // Delivery Target
  deliveryLocation  String?  // Delivery Location
  releaseDate       DateTime @default(now())
  dateReleased      DateTime? // Date Released
  
  requesterId   String
  requester     User     @relation(fields: [requesterId], references: [id])
  
  items         WarehouseReleaseItem[]
  createdAt     DateTime @default(now())
}

model WarehouseReleaseItem {
  id                 Int              @id @default(autoincrement())
  warehouseReleaseId String
  release            WarehouseRelease @relation(fields: [warehouseReleaseId], references: [id], onDelete: Cascade)
  
  reqNo              String?          // Req No.
  requestor          String?          // Requestor
  approval           String?          // Approval
  description        String           // Item Description
  elsPartNum         String?          // ELS Part Number
  manufacturer       String?          // Manufacturer
  requestQty         Int?             // Request Qty
  remainingQty       Int?             // Remaining Qty
  qty                Int              // Out/Release Qty
  unit               String
}

model Inventory {
  id          String @id @default(cuid())
  itemName    String
  sku         String @unique
  stockQty    Int    @default(0)
  unit        String
}

model SuratJalan {
  id                String   @id @default(cuid())
  materialRequestId String
  request           MaterialRequest @relation(fields: [materialRequestId], references: [id])
  driverName        String
  vehiclePlate      String
  issuedAt          DateTime @default(now())
}
