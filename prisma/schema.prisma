generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENGINEER
  PROCUREMENT
  MARKETING
  WPO
  PROJECT_MANAGER
  FINANCE
  WAREHOUSE
}

enum EngineerRole {
  STAFF
  WPO
  SYSTEM
}

enum BomStatus {
  DRAFT
  SUBMITTED
  WPO_REVIEW
  WPO_APPROVED
  WPO_REJECTED
  SYSTEM_REVIEW
  SYSTEM_APPROVED
  SYSTEM_REJECTED
  REJECTED
  ACTIVE
  ARCHIVED
}

enum BomItemStatus {
  PENDING
  REFINED
  APPROVED
  REJECTED
  PRICED
}

enum Status {
  WAITING_WPO
  WAITING_PM
  APPROVED
  PROCUREMENT_PROCESS
  FINANCE_PAID
  AVAILABLE_IN_WAREHOUSE
  SHIPPED
  REJECTED
}

enum FaultStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  password     String
  name         String
  role         Role    @default(ENGINEER)
  engineerRole EngineerRole? // Only populated if role = ENGINEER
  position     String?
  createdAt    DateTime @default(now())

  // Existing Relations - MaterialRequest
  materialRequests MaterialRequest[] @relation("RequestedBy")
  pmApprovals      MaterialRequest[] @relation("PMApprovedBy")
  wpoApprovals     MaterialRequest[] @relation("WPOApprovedBy")

  // Existing Relations - FaultReport & Warehouse
  faultReports     FaultReport[]
  warehouseReleases WarehouseRelease[]

  // New Relations - BoM
  bomsCreated      BillOfMaterial[] @relation("BomCreatedBy")
  bomsSubmitted    BillOfMaterial[] @relation("BomSubmittedBy")
  bomsWpoApproved  BillOfMaterial[] @relation("BomWpoApprovedBy")
  bomsSystemApproved BillOfMaterial[] @relation("BomSystemApprovedBy")
  bomHistories     BomHistory[]
}

model MaterialRequest {
  id              String   @id @default(cuid()) 
  docControlNo    String   @unique // Format: MR-2026-XXXX
  projectId       String
  projectName     String
  assignSys       String?  // Assign Sys
  assignPM        String?  // Assign PM
  workPackage     String?
  wpo             String?
  keterangan      String?
  status          Status   @default(WAITING_WPO)
  fileUrl         String?  // Lampiran file
  dateReleased    DateTime? // Date Released
  
  items           MaterialRequestItem[]
  suratJalan      SuratJalan[]
  warehouseReleases WarehouseRelease[] // New relation

  requestedBy     String   
  requester       User     @relation("RequestedBy", fields: [requestedBy], references: [id])
  
  wpoApprovedBy   String?  
  wpoApprover     User?    @relation("WPOApprovedBy", fields: [wpoApprovedBy], references: [id])
  
  pmApprovedBy    String?  
  pmApprover      User?    @relation("PMApprovedBy", fields: [pmApprovedBy], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaterialRequestItem {
  id                    Int      @id @default(autoincrement())
  materialRequestId     String
  request               MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  
  description           String
  elsicomPartNum        String?
  manufacturePartNum    String?
  type                  String?  // Type
  manufacturer          String?  // Manufacturer
  qty                   Int
  unit                  String
  targetDate            DateTime?
  remarks               String?
}

model FaultReport {
  id            String      @id @default(cuid())
  docNo         String      @unique // FR-2026-XXXX
  projectId     String?     // Project ID
  projectName   String
  itemName      String?     // Item Name
  manufacturer  String?     // Manufacturer
  targetRepair  DateTime?   // Target Repair
  faultIssue    String?     // Fault Issue
  priority      Priority    @default(MEDIUM)
  status        FaultStatus @default(OPEN)
  description   String?     @db.Text
  
  reportedBy    String
  reporter      User        @relation(fields: [reportedBy], references: [id])
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model WarehouseRelease {
  id                String   @id @default(cuid())
  docNo             String   @unique // WR-2026-XXXX
  
  materialRequestId String?  // Optional: Link to MR
  materialRequest   MaterialRequest? @relation(fields: [materialRequestId], references: [id])

  projectId         String?
  projectName       String?  // Project Name
  deliveryTarget    String?  // Delivery Target
  deliveryLocation  String?  // Delivery Location
  releaseDate       DateTime @default(now())
  dateReleased      DateTime? // Date Released
  
  requesterId   String
  requester     User     @relation(fields: [requesterId], references: [id])
  
  items         WarehouseReleaseItem[]
  createdAt     DateTime @default(now())
}

model WarehouseReleaseItem {
  id                 Int              @id @default(autoincrement())
  warehouseReleaseId String
  release            WarehouseRelease @relation(fields: [warehouseReleaseId], references: [id], onDelete: Cascade)
  
  reqNo              String?          // Req No.
  requestor          String?          // Requestor
  approval           String?          // Approval
  description        String           // Item Description
  elsPartNum         String?          // ELS Part Number
  manufacturer       String?          // Manufacturer
  requestQty         Int?             // Request Qty
  remainingQty       Int?             // Remaining Qty
  qty                Int              // Out/Release Qty
  unit               String
}

model Inventory {
  id          String @id @default(cuid())
  itemName    String
  sku         String @unique
  stockQty    Int    @default(0)
  unit        String
}

model SuratJalan {
  id                String   @id @default(cuid())
  materialRequestId String
  request           MaterialRequest @relation(fields: [materialRequestId], references: [id])
  driverName        String
  vehiclePlate      String
  issuedAt          DateTime @default(now())
}

// ========== BoM (Bill of Material) Models ==========

model BillOfMaterial {
  id                String   @id @default(cuid())
  bomNo             String   @unique          // Format: BOM-2026-XXXX

  // Project Reference
  projectId         String
  projectName       String
  projectCode       String                    // Contoh: "2244"
  contractNo        String?

  // Metadata
  bomStatus         BomStatus @default(DRAFT)
  description       String?   @db.Text

  // Ownership & Approval
  createdBy         String
  creator           User      @relation("BomCreatedBy", fields: [createdBy], references: [id])

  submittedBy       String?
  submitter         User?     @relation("BomSubmittedBy", fields: [submittedBy], references: [id])

  wpoApprovedBy     String?
  wpoApprover       User?     @relation("BomWpoApprovedBy", fields: [wpoApprovedBy], references: [id])
  wpoApprovedAt     DateTime?
  wpoRemarks        String?

  systemApprovedBy  String?
  systemApprover    User?     @relation("BomSystemApprovedBy", fields: [systemApprovedBy], references: [id])
  systemApprovedAt  DateTime?
  systemRemarks     String?

  // Items dalam BoM
  items             BomItem[]

  // History audit trail
  histories         BomHistory[]

  // Timeline
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  submittedAt       DateTime?

  @@index([projectId])
  @@index([bomStatus])
}

model BomItem {
  id                String   @id @default(cuid())
  bomId             String
  bom               BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  // Marketing baseline (dari kontrak)
  marketingDesc     String                    // Deskripsi dari kontrak
  marketingQty      Int?                      // Qty dari kontrak (optional)
  marketingUnit     String?                   // Unit dari kontrak (optional)

  // Engineer rincian (oleh Engineer Staff)
  itemStatus        BomItemStatus @default(PENDING)
  refinedDesc       String?                   // Deskripsi lebih detail dari engineer
  refinedQty        Int?                      // Qty yang diminta engineer
  refinedUnit       String?
  notes             String?   @db.Text        // Catatan dari engineer

  // Procurement pricing
  unitPrice         Decimal?  @db.Decimal(15, 2)
  totalPrice        Decimal?  @db.Decimal(15, 2) // refinedQty * unitPrice
  currency          String?   @default("IDR")
  supplier          String?
  leadTime          Int?                      // Hari

  // Approval tracking
  rejectionReason   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bomId])
  @@index([itemStatus])
}

model BomHistory {
  id                String   @id @default(cuid())
  bomId             String
  bom               BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  action            String                    // "CREATED", "SUBMITTED", "APPROVED", "REJECTED", etc
  performedBy       String
  user              User      @relation(fields: [performedBy], references: [id])

  details           String?   @db.Text
  previousData      String?   @db.Text        // JSON snapshot sebelum
  newData           String?   @db.Text        // JSON snapshot sesudah

  timestamp         DateTime @default(now())

  @@index([bomId])
}
