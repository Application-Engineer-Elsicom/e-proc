// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model MaterialRequest {
  id              Int      @id @default(autoincrement())
  projectId       String
  projectName     String?
  itemDescription String?
  qty             Int?
  unit            String?
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("USER")     // Contoh: ADMIN, ENGINEER, MANAGER
  position  String?                       // Contoh: Project Manager, System Manager
  createdAt DateTime @default(now())
}